{
  "name": "@smhit/api",
  "version": "0.1.0",
  "private": true,
  "description": "SMHIT — Backend Express/TypeScript (API REST, Auth JWT+RBAC, moteur de rapport, jobs OCR)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "seed:products": "ts-node --transpile-only src/seed/seedProducts.ts",
    "seed:admin": "ts-node --transpile-only src/seed/seedAdmin.ts",
    "seed:products:prod": "node dist/seed/seedProducts.js",
    "seed:admin:prod": "node dist/seed/seedAdmin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "axios": "^1.7.7",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
