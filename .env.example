# ============================================================
# SMHIT — variables d'environnement partagées (racine / docker-compose)
# Copier en .env et adapter. Chaque app a aussi son propre .env.example.
# ============================================================

# --- Ports exposés ---
WEB_PORT=3000
API_PORT=4000
AI_OCR_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=smhit
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_DB_NAME=smhit
MONGO_URI=mongodb://smhit:change_me@mongo:27017/smhit?authSource=admin

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO (stockage fichiers S3-compatible) ---
MINIO_ROOT_USER=smhit
MINIO_ROOT_PASSWORD=change_me_too
MINIO_BUCKET=smhit-files
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false

# --- Auth JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Microservice IA/OCR ---
AI_OCR_URL=http://ai-ocr:8000
AI_OCR_CONFIDENCE_THRESHOLD=0.75

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
